---

<div class="card p-6 transition-all duration-300 hover:translate-y-[-5px] hover:shadow-xl">
  <div class="mb-4 rounded-full bg-sky-100 p-3 text-sky-600 inline-block dark:bg-sky-900 dark:text-sky-400">
    <span set:html={icons[icon]} />
  </div>
  
  <h3 class="mb-3 text-lg font-medium text-cloud-900 dark:text-cloud-50">{title}</h3>
  
  <p class="text-cloud-600 dark:text-cloud-400">
    {description}
  </p>
</div>