---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CodeBlock from '../components/CodeBlock.astro';

---

<Layout title="API Reference - Weather ETL Pipeline Documentation">
  <HeroSection
    title="API Reference"
    subtitle="Complete documentation of the Weather ETL Pipeline API"
  />

  <div class="container mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-6 text-cloud-900 dark:text-cloud-50">
        Core API
      </h2>

      <div class="space-y-8">
        <!-- WeatherETL Class -->
        <div class="bg-white dark:bg-cloud-800 rounded-lg shadow-md p-6">
          <h3 class="text-xl font-medium mb-4 text-cloud-900 dark:text-cloud-50">
            WeatherETL
          </h3>
          
          <p class="mb-4 text-cloud-700 dark:text-cloud-300">
            The main class for handling the ETL pipeline operations.
          </p>

          <CodeBlock language="python" filename="example.py">
from weather_etl import WeatherETL

# Initialize the ETL pipeline
etl = WeatherETL(config)

# Run the complete ETL process
results = etl.run()

# Or run individual steps
data = etl.extract_data("London,UK")
transformed = etl.transform_data(data)
success = etl.load_data(transformed)
          </CodeBlock>

          <h4 class="text-lg font-medium mt-6 mb-3 text-cloud-900 dark:text-cloud-50">
            Methods
          </h4>

          <div class="space-y-4">
            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">run()</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                Executes the complete ETL pipeline for all configured locations.
              </p>
            </div>

            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">extract_data(location: str)</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                Retrieves weather data for a specific location from OpenWeatherMap API.
              </p>
            </div>

            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">transform_data(data: dict)</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                Transforms raw weather data into a structured format.
              </p>
            </div>

            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">load_data(data: dict)</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                Loads transformed data into the Supabase database.
              </p>
            </div>
          </div>
        </div>

        <!-- Config Class -->
        <div class="bg-white dark:bg-cloud-800 rounded-lg shadow-md p-6">
          <h3 class="text-xl font-medium mb-4 text-cloud-900 dark:text-cloud-50">
            Config
          </h3>
          
          <p class="mb-4 text-cloud-700 dark:text-cloud-300">
            Configuration class for setting up the ETL pipeline.
          </p>

          <CodeBlock language="python" filename="example.py">
from weather_etl import Config

config = Config(
    api_key="your_openweathermap_api_key",
    supabase_url="your_supabase_url",
    supabase_key="your_supabase_key",
    locations=["London,UK", "New York,US"],
    update_frequency=3600
)
          </CodeBlock>

          <h4 class="text-lg font-medium mt-6 mb-3 text-cloud-900 dark:text-cloud-50">
            Parameters
          </h4>

          <div class="space-y-4">
            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">api_key: str</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                Your OpenWeatherMap API key.
              </p>
            </div>

            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">supabase_url: str</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                Your Supabase project URL.
              </p>
            </div>

            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">supabase_key: str</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                Your Supabase API key.
              </p>
            </div>

            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">locations: List[str]</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                List of locations to monitor (format: "City,CountryCode").
              </p>
            </div>

            <div>
              <h5 class="font-medium text-cloud-900 dark:text-cloud-50">update_frequency: int</h5>
              <p class="text-cloud-700 dark:text-cloud-300">
                Time between updates in seconds (default: 3600).
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-6 text-cloud-900 dark:text-cloud-50">
        Database Schema
      </h2>

      <div class="bg-white dark:bg-cloud-800 rounded-lg shadow-md p-6">
        <h3 class="text-xl font-medium mb-4 text-cloud-900 dark:text-cloud-50">
          Tables
        </h3>

        <div class="space-y-6">
          <div>
            <h4 class="text-lg font-medium mb-2 text-cloud-900 dark:text-cloud-50">weather_locations</h4>
            <CodeBlock language="sql">
CREATE TABLE weather_locations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    city_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    country TEXT NOT NULL,
    latitude FLOAT NOT NULL,
    longitude FLOAT NOT NULL,
    created_at TIMESTAMPTZ DEFAULT now(),
    active BOOLEAN DEFAULT true
);
            </CodeBlock>
          </div>

          <div>
            <h4 class="text-lg font-medium mb-2 text-cloud-900 dark:text-cloud-50">weather_data</h4>
            <CodeBlock language="sql">
CREATE TABLE weather_data (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    location_id UUID REFERENCES weather_locations(id),
    timestamp TIMESTAMPTZ NOT NULL,
    temperature FLOAT NOT NULL,
    feels_like FLOAT,
    humidity INTEGER,
    pressure INTEGER,
    wind_speed FLOAT,
    wind_direction INTEGER,
    weather_main TEXT,
    weather_description TEXT,
    collected_at TIMESTAMPTZ DEFAULT now()
);
            </CodeBlock>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>