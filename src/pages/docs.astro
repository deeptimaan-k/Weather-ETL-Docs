---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CodeBlock from '../components/CodeBlock.astro';
import StepProgress from '../components/StepProgress.astro';

const steps = [
  {
    title: "Installation",
    description: "Install the package and set up dependencies"
  },
  {
    title: "Configuration",
    description: "Configure API keys and settings"
  },
  {
    title: "Database Setup",
    description: "Initialize the database schema"
  }
];
---

<Layout title="Documentation - Weather ETL Pipeline">
  <HeroSection
    title="Documentation"
    subtitle="Learn how to use the Weather ETL Pipeline effectively"
  />

  <div class="container mx-auto px-4 py-12">
    <StepProgress steps={steps} currentStep={1} />

    <div class="mt-12 space-y-12">
      <section>
        <h2 class="text-2xl font-bold mb-6">Getting Started</h2>
        <div class="card p-4 rounded-lg shadow bg-white dark:bg-gray-800">
          <h3 class="text-xl mb-4">Installation</h3>
          <CodeBlock language="bash">
            npm install weather-etl
          </CodeBlock>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6">Basic Usage</h2>
        <div class="card p-4 rounded-lg shadow bg-white dark:bg-gray-800">
          <CodeBlock language="typescript">
{`import { WeatherETL } from 'weather-etl';

const etl = new WeatherETL({
  apiKey: 'your-api-key',
  locations: ['London,UK', 'New York,US']
});

await etl.run();`}
          </CodeBlock>
        </div>
      </section>
    </div>
  </div>
</Layout>
