---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CodeBlock from '../components/CodeBlock.astro';
import StepProgress from '../components/StepProgress.astro';
import WeatherChart from '../components/WeatherChart.tsx';

const steps = [
  {
    title: "Installation",
    description: "Install the package and set up dependencies"
  },
  {
    title: "Configuration",
    description: "Configure API keys and settings"
  },
  {
    title: "Database Setup",
    description: "Initialize the database schema"
  }
];
---

<Layout title="Documentation - Weather ETL Pipeline">
  <HeroSection
    title="Documentation"
    subtitle="Learn how to use the Weather ETL Pipeline effectively with our comprehensive guide"
  />

  <div class="container mx-auto px-4 py-12">
    <StepProgress steps={steps} currentStep={1} />

    <div class="mt-12 space-y-12">
      <section>
        <h2 class="text-2xl font-bold mb-6">Getting Started</h2>
        <div class="card p-6 rounded-lg shadow bg-white dark:bg-cloud-800">
          <p class="mb-6">
            The Weather ETL Pipeline is a powerful tool for collecting and processing weather data.
          </p>

          <h3 class="text-xl font-semibold mb-4">1. Installation</h3>
          <p class="mb-4">Install the package using npm:</p>
          <CodeBlock language="bash">
npm install weather-etl
          </CodeBlock>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6">Configuration Setup</h2>
        <div class="card p-6 rounded-lg shadow bg-white dark:bg-cloud-800">
          <h3 class="text-xl font-semibold mb-4">Environment Variables</h3>
          <CodeBlock language="bash">
OPENWEATHER_API_KEY=your_api_key_here
SUPABASE_URL=your_supabase_url
          </CodeBlock>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold mb-6">Data Visualization</h2>
        <div class="card p-6 rounded-lg shadow bg-white dark:bg-cloud-800">
          <p class="mb-6">Here's an example weather chart:</p>
          <WeatherChart client:load />
        </div>
      </section>
    </div>
  </div>
</Layout>
