---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import CodeBlock from '../components/CodeBlock.astro';
import StepProgress from '../components/StepProgress.astro';

const installSteps = [
  {
    title: "Setup Environment",
    description: "Create a Python virtual environment and install dependencies"
  },
  {
    title: "Configure API Keys",
    description: "Set up your OpenWeatherMap and Supabase credentials"
  },
  {
    title: "Initialize Database",
    description: "Create the weather_data table in Supabase"
  },
  {
    title: "Run Pipeline",
    description: "Execute your first ETL pipeline run"
  }
];
---

<Layout title="Installation - Weather ETL Pipeline">
  <HeroSection
    title="Installation & Setup"
    subtitle="Get started with the Weather ETL Pipeline in a few simple steps"
  />

  <div class="container mx-auto px-4 py-12">
    <StepProgress steps={installSteps} currentStep={1} />

    <div class="mt-12 space-y-8">

      <!-- Prerequisites -->
      <section>
        <h2 class="text-2xl font-bold mb-6">Prerequisites</h2>
        <div class="card">
          <p class="mb-4">Before you begin, ensure you have the following:</p>
          <ul class="list-disc pl-6 space-y-2">
            <li>Python 3.8 or higher installed</li>
            <li>OpenWeatherMap API key</li>
            <li>Supabase project</li>
            <li>pip installed</li>
          </ul>
          <div class="mt-6 bg-sky-50 dark:bg-sky-900/30 rounded-lg p-4">
            <h4 class="text-lg font-medium mb-2">💡 Pro Tip</h4>
            <p>Use pyenv or asdf to manage Python versions and avoid conflicts.</p>
          </div>
        </div>
      </section>

      <!-- Installation -->
      <section>
        <h2 class="text-2xl font-bold mb-6">Step-by-Step Installation</h2>
        <div class="card space-y-6">
          <div>
            <h3 class="text-xl font-semibold mb-4">1. Create Virtual Environment</h3>
            <p>Create and activate a virtual environment:</p>
            <CodeBlock language="bash">
{`# Create virtual environment
python -m venv venv

# Activate environment
# macOS/Linux:
source venv/bin/activate
# Windows:
venv\\Scripts\\activate`}
            </CodeBlock>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-4">2. Install Dependencies</h3>
            <p>Install packages via pip:</p>
            <CodeBlock language="bash">
{`# Install from requirements.txt
pip install -r requirements.txt

# Or install manually
pip install psycopg2-binary requests pandas python-dotenv`}
            </CodeBlock>
          </div>
        </div>
      </section>

      <!-- Environment Config -->
      <section>
        <h2 class="text-2xl font-bold mb-6">Environment Configuration</h2>
        <div class="card">
          <p>Create a `.env` file in your root:</p>
          <CodeBlock language="bash">
{`# API Configuration
OPENWEATHER_API_KEY=your_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# DB Configuration
DB_HOST=your_host
DB_PORT=6543
DB_NAME=your_db
DB_USER=your_user
DB_PASSWORD=your_password

# App Settings
LOG_LEVEL=info
UPDATE_INTERVAL=3600`}
          </CodeBlock>
          <div class="mt-6 bg-amber-50 dark:bg-amber-900/30 rounded-lg p-4">
            <h4 class="text-lg font-medium mb-2">⚠️ Security Note</h4>
            <p>Never commit `.env` files. Add to `.gitignore` to protect credentials.</p>
          </div>
        </div>
      </section>

      <!-- Database Setup -->
      <section>
        <h2 class="text-2xl font-bold mb-6">Database Setup</h2>
        <div class="card">
          <p>Create this table in Supabase:</p>
          <CodeBlock language="sql">
{`-- Create weather_data table
CREATE TABLE weather_data (
  id SERIAL PRIMARY KEY,
  city_name VARCHAR(100),
  temperature FLOAT,
  humidity INTEGER,
  weather_description VARCHAR(255),
  timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Indexes
CREATE INDEX idx_weather_data_city_name ON weather_data(city_name);
CREATE INDEX idx_weather_data_timestamp ON weather_data(timestamp);`}
          </CodeBlock>

          <h3 class="text-xl font-semibold mt-6 mb-4">Test DB Connection</h3>
          <p>Run this Python script:</p>
          <CodeBlock language="python">
{`import os
from dotenv import load_dotenv
import psycopg2

load_dotenv()

def test_connection():
    try:
        conn = psycopg2.connect(
            host=os.getenv("DB_HOST"),
            dbname=os.getenv("DB_NAME"),
            user=os.getenv("DB_USER"),
            password=os.getenv("DB_PASSWORD"),
            port=os.getenv("DB_PORT")
        )
        print("Database connection successful!")
        conn.close()
    except Exception as e:
        print(f"Connection failed: {e}")

test_connection()`}
          </CodeBlock>
        </div>
      </section>

      <!-- Run Pipeline -->
      <section>
        <h2 class="text-2xl font-bold mb-6">Running the Pipeline</h2>
        <div class="card">
          <p>Start collecting weather data:</p>
          <CodeBlock language="python">
{`# Run the ETL pipeline
python etl_pipeline.py`}
          </CodeBlock>

          <h3 class="text-xl font-semibold mt-6">Verify Operation</h3>
          <ul class="list-disc pl-6 space-y-2">
            <li>Check logs in `etl.log`</li>
            <li>Verify `weather_data` table entries</li>
            <li>Inspect `output/cleaned_weather.csv`</li>
          </ul>
        </div>
      </section>
    </div>
  </div>
</Layout>
